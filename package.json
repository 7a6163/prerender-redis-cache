{
  "name": "prerender-redis-cache",
  "version": "0.2.2",
  "description": "Prerender plugin for Redis caching",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/jonathanbennett/prerender-redis-cache.git"
  },
  "keywords": [
    "prerender",
    "redis",
    "cache"
  ],
  "author": "Jonathan Bennett",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jonathanbennett/prerender-redis-cache/issues"
  },
  "homepage": "https://github.com/jonathanbennett/prerender-redis-cache",
  "dependencies": {
    "redis": "^5.9.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "redis-mock": "^0.56.3"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "lib/**/*.js",
      "!lib/**/*.test.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/*.test.js"
    ]
  }
}
